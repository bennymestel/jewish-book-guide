{
  "mcpServers": {
    "youtube": {
      "command": "npx",
      "args": ["-y", "@kirbah/mcp-youtube"],
      "env": {
        "YOUTUBE_API_KEY": "${YOUTUBE_API_KEY}"
      }
    },
    "sefaria-texts": {
      "type": "sse",
      "url": "https://mcp.sefaria.org/sse"
    },
    "sefaria-dev": {
      "type": "http",
      "url": "https://developers.sefaria.org/mcp"
    }
  }
}
