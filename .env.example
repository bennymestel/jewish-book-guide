GOOGLE_API_KEY=your_google_gemini_api_key_here
DATABASE_URL=postgresql://localhost/books
YOUTUBE_API_KEY=your_youtube_api_key_here   # optional
GEMINI_MODEL=gemini-3.1-flash-lite-preview  # optional, override the default model

OPENROUTER_API_KEY=your_openrouter_api_key_here   # needed for the judge and for model sweeps

# Recommended: a judge from a family that isn't being evaluated, to avoid self-preference
# bias. Defaults to GEMINI_MODEL if unset.
JUDGE_MODEL=anthropic/claude-haiku-4.5

# Local multi-model experiments only — never set these in deployment.
# AGENT_MODEL=qwen/qwen3-235b-a22b   # a "/" in the id routes to OpenRouter
# LLM_PROVIDER=                      # optional explicit override: google | openrouter

# Abuse protection (only matters for a public deployment; safe defaults for local dev)
ALLOWED_ORIGINS=                            # optional, comma-separated; empty = no cross-origin browser access
DAILY_REQUEST_LIMIT=300                     # optional, global daily cap on LLM-backed requests (in-process, single instance)

# LangSmith observability (optional but recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=jewish-book-guide
